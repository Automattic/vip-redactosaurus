{
  "settings": {
    "processInterval": 100,
    "maxRetries": 0,
    "debug": false,
    "showDemoIndicator": false,
    "headlineMode": "replace",
    "authorMode": "replace",
    "thumbnailMode": "replace"
  },
  "urlPatterns": {
    "parsely": {
      "pattern": "https://dash\\.parsely\\.com/([^/?]+)",
      "customerIdGroup": 1
    },
    "hosting-dashboard": {
      "pattern": "dashboard\\.wpvip\\.com/apps/([^/?]+)",
      "customerIdGroup": 1
    }
  },
  "transformations": [
    {
      "name": "headlines_replace",
      "type": "functionReplace",
      "enabled": true,
      "enabledSetting": "headlineMode",
      "enabledValue": "replace",
      "selectors": [
        "a.post-title",
        "a[href*='/campaigns/id/']",
        "div.title > h1",
        "div.title > a[target=\"_blank\"] span",
        ".card-node.post-node .title > a > div"
      ],
      "options": {
        "functionName": "generateRandomHeadline",
        "functionArgs": {}
      }
    },
    {
      "name": "headlines_scramble",
      "type": "scramble",
      "enabled": true,
      "enabledSetting": "headlineMode",
      "enabledValue": "scramble",
      "selectors": [
        "a.post-title",
        "a[href*='/campaigns/id/']",
        "div.title > h1",
        "div.title > a[target=\"_blank\"] span",
        ".card-node.post-node .title > a > div"
      ],
      "options": {
        "preserveCase": true,
        "preservePunctuation": true,
        "preserveSpaces": true,
        "preserveLength": true,
        "preserveEnds": true,
        "maxWordLength": 0
      }
    },
    {
      "name": "authors_scramble",
      "type": "scramble",
      "enabled": true,
      "enabledSetting": "authorMode",
      "enabledValue": "scramble",
      "selectors": [
        "a[href*='/authors/']:not([href*='/authors/?']):not([href$='/authors/'])",
        ".card-node.post-node .author > a"
      ],
      "options": {
        "preserveCase": true,
        "preservePunctuation": true,
        "preserveSpaces": true,
        "preserveLength": true,
        "preserveEnds": true,
        "maxWordLength": 0
      }
    },
    {
      "name": "authors_replace",
      "type": "functionReplace",
      "enabled": true,
      "enabledSetting": "authorMode",
      "enabledValue": "replace",
      "selectors": [
        "a[href*='/authors/']:not([href*='/authors/?']):not([href$='/authors/'])",
        ".card-node.post-node .author > a"
      ],
      "options": {
        "functionName": "generateRandomAuthorName",
        "functionArgs": {
          "firstNames": [
            "Aisha", "Benjamin", "Carmen", "Dmitri", "Elena", "Finn", "Grace", "Hassan", "Isabella", "Jin", "Kenji", "Lucia", "Miguel", "Nora", "Omar", "Priya", "Quinn", "Raj", "Sofia", "Tomoko", "Ulrich", "Veronica", "Wei", "Ximena", "Yuki", "Zara", "Adrian", "Beatrice", "Carlos", "Diana", "Ethan", "Fatima", "Gabriel", "Hana", "Ivan", "Jasmine", "Klaus", "Leila", "Marco", "Natasha", "Oscar", "Petra", "Quincy", "Rosa", "Sebastian", "Tara", "Uri", "Victoria", "Wolfgang", "Xander", "Yvette", "Zachary"
          ],
          "lastNames": [
            "Anderson", "Blackwood", "Chen", "Delacroix", "Eriksson", "Fernandez", "Gonzalez", "Hoffman", "Ivanov", "Jackson", "Kim", "Lopez", "Murphy", "Nakamura", "O'Brien", "Patel", "Quinn", "Rodriguez", "Singh", "Thompson", "Ueda", "Volkov", "Williams", "Xu", "Yamamoto", "Ziegler", "Abramovich", "Brennan", "Castillo", "Davies", "Fischer", "Hashimoto", "Ibrahim", "Jensen", "Kowalski", "Laurent", "Nielsen", "Okafor", "Petrov", "Qureshi", "Rossi", "Swanson", "Taylor", "Underwood", "Varga", "Walsh", "Xiang", "Yoshida", "Zimmerman"
          ]
        }
      }
    },
    {
      "name": "section_names",
      "type": "functionReplace",
      "selectors": [
        "a[href*='/sections/']:not([href*='/sections/?']):not([href$='/sections/'])",
        ".card-node.post-node .section > a"
      ],
      "options": {
        "functionName": "generateRandomSectionName",
        "functionArgs": {}
      }
    },
    {
      "name": "filter_summary_sections",
      "type": "functionReplace",
      "selectors": [
        "#filters-summary-content .values"
      ],
      "options": {
        "functionName": "generateRandomSectionList",
        "functionArgs": {}
      }
    },
    {
      "name": "article_thumbnails_replace",
      "type": "defaultImage",
      "enabled": true,
      "enabledSetting": "thumbnailMode",
      "enabledValue": "replace",
      "selectors": [
        "div.thumb img"
      ],
      "options": {
        "poolIndex": "assets/thumbnails/index.json"
      }
    },
    {
      "name": "article_thumbnails_blur",
      "type": "blur",
      "enabled": true,
      "enabledSetting": "thumbnailMode",
      "enabledValue": "blur",
      "selectors": [
        "div.thumb img"
      ],
      "options": {
        "blurAmount": "3px"
      }
    },
    {
      "name": "publisher_name",
      "type": "functionReplace",
      "selectors": [
        "a.publisher-link span.publisher-info"
      ],
      "options": {
        "functionName": "generatePublisherName",
        "functionArgs": {},
        "preserveChildren": true
      }
    },
    {
      "name": "seo_scramble",
      "type": "scramble",
      "selectors": [
        "div.google-key-label",
        "div.keyword-container > div.keyword"
      ],
      "options": {
        "preserveCase": true,
        "preservePunctuation": true,
        "preserveSpaces": true,
        "preserveLength": true,
        "preserveEnds": true
      }
    },
    {
      "name": "goals_scramble",
      "type": "scramble",
      "selectors": [
        "div.goals-listings .goal-card-name",
        "div.goal-listing .name",
        "div.modal-body .goal-name",
        "#tooltip"
      ],
      "options": {
        "preserveCase": true,
        "preservePunctuation": true,
        "preserveSpaces": true,
        "preserveLength": true,
        "preserveEnds": true
      }
    },
    {
      "name": "journeys_labels",
      "type": "scramble",
      "selectors": [
        ".card-node-row--val-container.label a"
      ],
      "options": {
        "preserveCase": true,
        "preservePunctuation": true,
        "preserveSpaces": true,
        "preserveLength": true,
        "preserveEnds": true
      }
    },
    {
      "name": "site_picker_scramble",
      "type": "scramble",
      "selectors": [
        "#popups .publisher .site-name-text span",
        "#popups .apikey .site-name-text span",
        "#popups .apikey-group .site-name-text span"
      ],
      "options": {
        "preserveCase": true,
        "preservePunctuation": true,
        "preserveSpaces": true,
        "preserveLength": true,
        "preserveEnds": true
      }
    }
  ],
  "globalCSS": {
    "enabled": true,
    "rules": [
      {
        "selector": "div.sitepicker div input.filter",
        "properties": {
          "color": "rgba(255, 0, 0, 0) !important"
        }
      }
    ],
    "files": [
      "assets/global.css"
    ]
  }
}
